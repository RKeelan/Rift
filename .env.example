# Server port (default: 13000)
PORT=13000

# Bind address (default: 127.0.0.1). Must be a loopback address (127.0.0.0/8,
# ::1, or localhost); the server refuses to start otherwise. Expose Rift to
# other devices with `tailscale serve`.
HOST=127.0.0.1

# Comma-separated Tailscale logins allowed through `tailscale serve`, compared
# case-insensitively. Unset or empty refuses every proxied request.
RIFT_ALLOWED_LOGINS=you@example.com

# Set to 1 (or true, yes, on) to allow saving files, staging, and unstaging.
# Anything else refuses every request that would change a file or a repo.
RIFT_ALLOW_WRITES=0

# Command to run for the agent process (default: echo)
AGENT_COMMAND=echo

# Root directory containing repositories. Required if it cannot be inferred
# from the current working directory (must contain a "src", "source", or
# "repos" segment under your home directory).
REPOS_ROOT=~/Src
